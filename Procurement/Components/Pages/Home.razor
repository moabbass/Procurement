@page "/"
@inject NavigationManager Nav

<div class="design-wrapper">
    <div class="design-card wide-card">
        <div class="home-header text-center mb-5">
            <h1 class="display-5 fw-bold text-primary">ProcureSmart Portal</h1>
            <p class="text-muted">Enterprise Procurement & Bid Management System</p>
            <div class="header-line mx-auto"></div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="portal-section-card h-100">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-building-fill-gear"></i>
                    </div>
                    <h4>Organizer Portal</h4>
                    <p>Create new procurement requests, manage vendor approvals, and review incoming offers.</p>
                    <div class="d-grid gap-2">
                        <button class="btn-action" >
                            <i class="bi bi-plus-circle me-2"></i> Create New Bid
                        </button>
                        <button class="btn-action" >
                            <i class="bi bi-list-task me-2"></i> Manage Bids
                        </button>
                        <button class="btn-action">
                            <i class="bi bi-people me-2"></i> View Offers
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="portal-section-card h-100">
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-truck"></i>
                    </div>
                    <h4>Supplier Portal</h4>
                    <p>Find available opportunities in your category and submit professional quotations.</p>
                    <div class="d-grid gap-2">
                        <button class="btn-action">
                            <i class="bi bi-search me-2"></i> Browse Public Bids
                        </button>
                        <button class="btn-action">
                            <i class="bi bi-file-earmark-check me-2"></i> Track My Offers
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>
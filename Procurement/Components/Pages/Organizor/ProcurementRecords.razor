@page "/procurementRecords"
@using Google.Cloud.Firestore
@using Procurement.Components.Model
@inject IConfiguration Config
@inject NavigationManager Nav
@inject BidTracker bidTracker

<div class="design-wrapper">
    <div class="design-card wide-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <button class="btn btn-outline-secondary btn-sm mb-2" @onclick='() => Nav.NavigateTo("/bidsOrganizor")'>
                    <i class="bi bi-arrow-left"></i> Back to Manager
                </button>
                <h3 class="form-title text-primary">Awarded Contracts & Analysis</h3>
            </div>
            <div class="text-end">
                <span class="badge bg-success p-2 px-3 shadow-sm">
                    <i class="bi bi-shield-check me-1"></i> Verified Records
                </span>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state text-center p-5">
                <div class="spinner-border text-info" role="status"></div>
                <p class="mt-2 text-muted">Analyzing procurement data...</p>
            </div>
        }
        else if (awardedItems.Count == 0)
        {
            <div class="alert alert-info border-0 shadow-sm text-center p-5">
                <i class="bi bi-folder2-open display-4 d-block mb-3 opacity-50"></i>
                No awarded contracts found in the records.
            </div>
        }
        else
        {
            <div class="row g-3 mb-5">
                <div class="col-md-4">
                    <div class="p-3 bg-primary text-white rounded shadow-sm">
                        <small class="text-uppercase opacity-75 fw-bold" style="font-size: 0.75rem;">Total Awarded Value</small>
                        <h3 class="mb-0 fw-bold">@awardedItems.Sum(b => b.QuoteAmount).ToString("C")</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white border rounded shadow-sm">
                        <small class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Total Savings</small>
                        @{
                            var savings = awardedItems.Sum(b => b.OrganizationBudget - b.QuoteAmount);
                        }
                        <h3 class="mb-0 text-success fw-bold">@savings.ToString("C")</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white border rounded shadow-sm">
                        <small class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Contracts Finalized</small>
                        <h3 class="mb-0 text-dark fw-bold">@awardedItems.Count</h3>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Date Awarded</th>
                                <th>Bid Details</th>
                                <th>Category</th>
                                <th class="text-end">Budget</th>
                                <th class="text-end">Final Price</th>
                                <th class="text-center">Efficiency</th>                              
                                <th class="text-center">Organization</th>                             
                                                           
                                                                
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in awardedItems.OrderByDescending(b => b.AwardedAt))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="text-muted small d-block text-uppercase">@item.AwardedAt.ToString("MMM yyyy")</span>
                                        <span class="fw-bold">@item.AwardedAt.ToString("dd")</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.BidDescription</div>
                                        <small class="text-muted">Ref: @item.BidId</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">@item.Category</span>
                                    </td>
                                    <td class="text-end text-muted small">@item.OrganizationBudget.ToString("C")</td>
                                    <td class="text-end fw-bold text-primary">@item.QuoteAmount.ToString("C")</td>
                                    <td class="text-center">
                                        @{
                                            var variance = item.OrganizationBudget - item.QuoteAmount;
                                            var isUnder = variance >= 0;
                                        }
                                        <span class="badge @(isUnder ? "bg-success" : "bg-danger") px-2">
                                            <i class="bi @(isUnder ? "bi-arrow-down-short" : "bi-arrow-up-short")"></i>
                                            @Math.Abs(variance).ToString("C")
                                        </span>
                                    </td>
                                    <td class="text-end text-muted small">
                                        <div class="text-dark">@item.OrganizationName</div>
                                        <small class="text-muted"> @item.supplierEmail</small>
                                    </td>
                                    
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // private List<Bid> awardedBids = new();
    private List<Item> awardedItems = new List<Item>();
    private bool isLoading = true;
    private FirestoreDb _db;

    protected override async Task OnInitializedAsync()
    {
        _db = FirestoreDb.Create(Config["Firebase:DB"]);
        await LoadHistoricalData();
        isLoading = false;
    }

    private async Task LoadHistoricalData()
    {
        try
        {
            // We filter for bids that are marked as closed and awarded
            BidController bc = new BidController();
            OfferController oc = new OfferController();

            List<Bid> awardedBids=await bc.getawardedBids();
            foreach (Bid bid in awardedBids)
            {
                Offer offer = await oc.GetOfferByID(bid.WinnerOfferId);

                if(offer!= null)
                {
                    awardedItems.Add(new Item
                    {
                        BidId = bid.Id,
                        BidDescription = bid.Description,
                        QuoteAmount = offer.TotalQuoteAmount,
                        OrganizationBudget = bid.decidedPrice,
                        OrganizationName = offer.Organization,
                        supplierEmail = offer.supplierEmail,
                        AwardedAt = bid.AwardedAt,
                        Category = bid.Category
                    });
                }
                Console.WriteLine("test");
            }            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error Loading Records: {ex.Message}");
        }
    }

    private void ViewDetails(string bidId)
    {
        bidTracker.setCurrentBidId(bidId);
        Nav.NavigateTo("/reviewOffers");
    }


    public class Item
    {
        public string BidId { get; set; }
        public string BidDescription { get; set; }
        public string Category{ get; set; }
        public DateTime AwardedAt { get; set; }
        public string OrganizationName { get; set; }
        public string supplierEmail { get; set; }
        public double QuoteAmount { get; set; }
        public double OrganizationBudget { get; set; }
        
    }
}
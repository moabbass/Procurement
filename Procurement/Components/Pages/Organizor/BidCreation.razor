@page "/BidCreation"
@inject AuthService authService
@using Google.Cloud.Firestore
@using Procurement.Components.Model
@inject FileService FileService
@inject NavigationManager Nav
@inject IConfiguration Config
@inject PDFValidatorService ValidatorService

<div class="design-wrapper">
    <div class="design-card wide-card">
        <div class="close-icon" @onclick='() => Nav.NavigateTo("/bidsOrganizor")'>&times;</div>
        <h3 class="form-title">Create New Bid</h3>

        <EditForm Model="bid" OnValidSubmit="PublishBid" class="offer-form">
            <div class="input-group-custom mb-3">
                <label>Description</label>
                <InputText @bind-Value="bid.Description" placeholder="Enter bid description..." class="custom-input" />
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="input-group-custom">
                        <label>Due Date</label>
                        <InputDate @bind-Value="bid.dueDate" class="custom-input" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-custom">
                        <label>Category</label>
                        <InputSelect @bind-Value="bid.Category" class="custom-input select-styled">
                            <option value="" disabled selected>Select Category</option>
                            @if (categories != null)
                            {
                                @foreach (string cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="form-check form-switch custom-switch-container mb-4">
                <input class="form-check-input custom-switch" type="checkbox" id="PublicSwitch" @bind="bid.Public">
                <label class="form-check-label ms-2" for="PublicSwitch">Make this bid public</label>
            </div>

            @if (!bid.Public)
            {
                <div class="invitation-panel mb-4">
                    <h5 class="section-subtitle">Invite Specific Suppliers</h5>
                    <p class="instruction-text">Search and select users in the <strong>@bid.Category</strong> category.</p>

                    <button type="button" class="btn-outline-custom mb-3" @onclick="SearchUsersByCategory">
                        <i class="bi bi-search me-2"></i> Find Users in Category
                    </button>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="list-label">Search Results</label>
                            <div class="invitation-list">
                                @foreach (var user in foundUsers)
                                {
                                    <div class="list-item-action" @onclick="() => AddToInvited(user.Email)">
                                        <span>@user.Email</span>
                                        <i class="bi bi-plus-circle-fill text-primary"></i>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="list-label">Invited List</label>
                            <div class="invitation-list invited">
                                @foreach (var email in bid.supliersList)
                                {
                                    <div class="list-item-static">
                                        <span>@email</span>
                                        <i class="bi bi-x-circle text-danger" style="cursor:pointer" @onclick="() => bid.supliersList.Remove(email)"></i>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="input-group-custom">
                        <label>Quantity</label>
                        <InputNumber @bind-Value="bid.Quantity" class="custom-input" />
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="input-group-custom">
                        <label>Estimated Budget (£)</label>
                        <InputNumber @bind-Value="bid.EstimatedBudget" class="custom-input" placeholder="0.00" />
                    </div>
                </div>
            </div>

            <div class="input-group-custom mb-3">
                <label>Delivery Location</label>
                <InputText @bind-Value="bid.DeliveryLocation" placeholder="e.g. CERN Prevessin Site, Building 867" class="custom-input" />
            </div>

            <div class="input-group-custom mb-4">
                <label>Technical Requirements</label>
                <InputTextArea @bind-Value="bid.TechnicalRequirements"
                               placeholder="Specify technical standards, dimensions, or specific certifications required..."
                               class="custom-input" rows="4" />
            </div>
            

            <div class="input-group-custom mb-4">
                <label>Supporting Document (PDF)</label>
                <InputFile OnChange="StoreFile" accept=".pdf" class="custom-input" />

                @if (isUploading)
                {
                    <div class="custom-progress mt-2">
                        <div class="custom-progress-bar"></div>
                    </div>
                }
                @if (isProcessing)
                {
                    <div class="d-flex align-items-center text-primary mt-3">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        <span>Gemini is analyzing your document...</span>
                    </div>
                }

                @if (validationResult != null)
                {
                    <div class="mt-4 alert @(validationResult.Value.IsViable ? "alert-success" : "alert-danger")">
                        <h5 class="alert-heading">
                            @(validationResult.Value.IsViable ? "✅ Document Validated" : "❌ Validation Failed")
                        </h5>
                        <p class="mb-0">@validationResult.Value.Reason</p>
                    </div>
                }
            </div>



            @if (published)
            {
                <div class="success-msg mb-3">
                    <i class="bi bi-check-circle"></i> Bid published successfully!
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-msg mb-3">
                    <i class="bi bi-exclamation-triangle"></i> @errorMessage
                </div>
            }

            <div class="form-actions mt-4">
                <button type="submit" class="btn-action">PUBLISH BID</button>
            </div>
        </EditForm>
    </div>
</div>


@code {
    private Bid bid;
    private List<User> foundUsers = new();
    private User user;
    private UserController uc = new UserController();
    private string? errorMessage;
    private IBrowserFile file = null;
    private bool isUploading = false;
    private bool published = false;
    private string? uploadedUrl;
    private List<string> categories;
    private FirestoreDb _db;

    private string contextType = "RFP";
    private bool isProcessing = false;
    private (bool IsViable, string Reason)? validationResult;

    protected override async Task OnInitializedAsync()
    {
        _db = FirestoreDb.Create(Config["Firebase:DB"]);
        categories = new List<string>();
        await GetCategoriesAsync();
    }

    protected override void OnInitialized()
    {        

        bid = new Bid();
        bid.dueDate = DateTime.Today; 
    }

    private async Task PublishBid()
    {
        if (file != null)
        {
            if (bid.EstimatedBudget <= 0 || string.IsNullOrEmpty(bid.DeliveryLocation) || string.IsNullOrEmpty(bid.Description) || string.IsNullOrEmpty(bid.Category) || string.IsNullOrEmpty(bid.TechnicalRequirements))
            {
                errorMessage = "You need to fill valid inputs in all the fields to publish a bid";
                return;
            }

            if (validationResult.Value.IsViable)
            {
                int bidCount = await _db.Collection("Bids").ListDocumentsAsync().CountAsync();

                CollectionReference collection = _db.Collection("Bids");

                bid.Id = $"{bidCount + 1}";


                try
                {
                    await HandleFileSelected(bid.Id);
                    var newBid = new
                    {
                        Id = bid.Id,
                        Description = bid.Description,
                        Category = bid.Category,
                        dueDate = DateTime.SpecifyKind(bid.dueDate, DateTimeKind.Utc),
                        Open = true,
                        Public = bid.Public,
                        supliersList = bid.supliersList,
                        Published = true,
                        fileName = bid.fileName,
                        Quantity = bid.Quantity,
                        EstimatedBudget = bid.EstimatedBudget,
                        TechnicalRequirements = bid.TechnicalRequirements,
                        DeliveryLocation = bid.DeliveryLocation
                    };

                    await collection.AddAsync(newBid);
                    published = true;

                }
                catch (Exception ex)
                {
                    errorMessage = ex.Message;
                }
            }
            else
            {
                errorMessage = "You need to upload a viable supporting document to publish a bid";
            }
        }
        else
        {
            errorMessage = "You need to upload supporting document to publish a bid";
        }

    }

    private async Task StoreFile(InputFileChangeEventArgs e)
    {
        file = e.File;
        if (file == null) return;

        if (file.ContentType != "application/pdf")
        {
            errorMessage = "Invalid file type. Please upload a PDF.";
            file = null;
            return;
        }
        //isUploading = true;

        // Open the stream 
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await validatePDF();
    }

    private async Task HandleFileSelected(string Id)
    {
        if (file == null) return;

        isUploading = true;

        StateHasChanged();
       
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

        try
        {
            //uploadedUrl = await FileService.UploadPdfAsync($"{regModel.Email}/" + "register", stream, file.Name);
            bid.fileName = file.Name;
            isUploading = false;            
            uploadedUrl = await FileService.UploadPdfAsync("Bids/" + $"{Id}", stream, file.Name, authService.CurrentUserToken);

            //user.fileName = file.Name;
        }
        catch (Exception ex)
        {
            
            errorMessage=ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    public async Task GetCategoriesAsync()
    {
        try
        {
            var snapshot = await _db.Collection("Categories").GetSnapshotAsync();
            foreach (DocumentSnapshot document in snapshot.Documents)
            {
                categories.Add(document.GetValue<string>("name"));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

    }

    private async Task SearchUsersByCategory()
    {
        if (string.IsNullOrEmpty(bid.Category))
        {
            errorMessage = "Please select a category first.";
            return;
        }

        try
        {            
            foundUsers = await uc.GetUsersByCategory(bid.Category);

            if (!foundUsers.Any())
            {
                errorMessage = "No users found in this category.";
            }
            else
            {
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error searching users: " + ex.Message;
        }
    }

    private async Task validatePDF()
    {        
        if (file == null) return;

        // Reset UI state
        isProcessing = true;
        validationResult = null;

        try
        {
            // Limit file size (e.g., 5MB) to prevent memory issues
            long maxFileSize = 1024 * 1024 * 5;

            using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            byte[] pdfBytes = ms.ToArray();

            
            validationResult = await ValidatorService.CheckPdfViabilityAsync(pdfBytes, contextType, Config);
        }
        catch (Exception ex)
        {
            validationResult = (false, $"Error reading file: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private void AddToInvited(string email)
    {
        if (!bid.supliersList.Contains(email))
        {
            bid.supliersList.Add(email);
        }
    }
}
